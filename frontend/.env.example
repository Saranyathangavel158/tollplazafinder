# Copy this file to ".env" (or ".env.local") to override the defaults. Never put API keys here:
# the Geoapify key stays on the backend and is not used by the frontend.

# Base URL of the backend API. Leave empty during development to use the Vite proxy
# (requests go to /api/... on the dev server and are forwarded to the backend).
# Set it to a full URL, e.g. https://api.example.com, only if the backend allows cross-origin
# requests from the frontend's origin (the backend has no CORS configuration at the moment).
VITE_API_BASE_URL=

# Where the dev server forwards "/api" requests. Used only by "npm run dev".
VITE_DEV_PROXY_TARGET=http://localhost:8080
